# ==========================================
# CineForge Enterprise AI Video Engine (.env.example)
# Phase 0 & 1 Environment Specification
# ==========================================

# Application & Runtime
NODE_ENV=development
ENVIRONMENT=development
STUDIO_BACKEND_URL=http://127.0.0.1:8008
STUDIO_WS_URL=http://127.0.0.1:8008
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8008
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8008

# Database (PostgreSQL 16 + AsyncPG)
POSTGRES_USER=studio
POSTGRES_PASSWORD=
POSTGRES_DB=studio_db
DATABASE_URL=postgresql+asyncpg://studio:studio_secret_pw@127.0.0.1:5432/studio_db

# Redis & ARQ Distributed Queue
REDIS_URL=redis://127.0.0.1:6379/0

# S3 / Cloudflare R2 / MinIO Object Storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_CDN_URL=http://127.0.0.1:9000/studio-assets
S3_BUCKET_NAME=studio-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Security & JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_SECRET=

# External AI Inference Providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
ELEVENLABS_API_KEY=
SYNCLABS_API_KEY=
