{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasterManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "version",
    "title",
    "format",
    "contextArtifactIds",
    "globalStyle",
    "consistencies",
    "scenes",
    "outroEndFrame",
    "assembly"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "cinematic_drama",
        "documentary",
        "explainer",
        "podcast_clip",
        "vertical_short"
      ]
    },
    "contextArtifactIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "globalStyle": {
      "$ref": "#/$defs/GlobalStyle"
    },
    "consistencies": {
      "$ref": "#/$defs/ConsistenciesContainer"
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneNode"
      }
    },
    "outroEndFrame": {
      "$ref": "#/$defs/OutroEndFrame"
    },
    "assembly": {
      "$ref": "#/$defs/AssemblyConfig"
    }
  },
  "$defs": {
    "AssetStatus": {
      "type": "string",
      "enum": [
        "idle",
        "queued",
        "generating",
        "completed",
        "failed"
      ]
    },
    "CharacterConsistency": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "description",
        "prompt360",
        "status",
        "progressPercent",
        "selectedAssetUrl",
        "variants"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "protagonist",
            "antagonist",
            "supporting",
            "narrator"
          ]
        },
        "description": {
          "type": "string"
        },
        "prompt360": {
          "type": "string"
        },
        "negativePrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/AssetStatus"
        },
        "progressPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedAssetUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ObjectConsistency": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "prompt360",
        "status",
        "progressPercent",
        "selectedAssetUrl",
        "variants"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "prop",
            "vehicle",
            "costume",
            "environment"
          ]
        },
        "prompt360": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AssetStatus"
        },
        "progressPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedAssetUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "GlobalStyle": {
      "type": "object",
      "required": [
        "aspectRatio",
        "resolution",
        "visualStylePrompt",
        "colorGradingPreset"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "1:1"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "1080p",
            "4k"
          ]
        },
        "visualStylePrompt": {
          "type": "string"
        },
        "colorGradingPreset": {
          "type": "string"
        },
        "musicGenrePrompt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ConsistenciesContainer": {
      "type": "object",
      "required": [
        "characters",
        "objects"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterConsistency"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectConsistency"
          }
        }
      }
    },
    "SceneNode": {
      "type": "object",
      "required": [
        "sceneNumber",
        "id",
        "timestamp",
        "visualDescription",
        "camera",
        "keyframe",
        "audio",
        "video"
      ]
    },
    "OutroEndFrame": {
      "type": "object",
      "required": [
        "prompt",
        "selectedAssetUrl",
        "variants",
        "status"
      ]
    },
    "AssemblyConfig": {
      "type": "object",
      "required": [
        "transitionType",
        "transitionDurationSec",
        "backgroundMusicUrl",
        "burnCaptions",
        "subtitleStyle",
        "thumbnail",
        "finalVideoUrl",
        "bundleZipUrl",
        "status",
        "progressPercent"
      ]
    }
  }
}
